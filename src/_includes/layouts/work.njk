---
layout: layouts/base.njk
layoutClass: work
---

<section class="intro">
  <p class="project-type">{{ type }}</p>
  <h1>{{ title }}</h1>
  <span class="read-time">{{ rt }}</span>
</section>

{% if hero %}
<figure>
  <img alt="{{ heroAlt or '' }}" src="/_assets/img/{{ hero }}" loading="eager" fetchpriority="high" />
</figure>
{% endif %}

{{ content | safe }}

{% if company %}
<aside class="notice">
  <p>Please note that all product screenshots and images of Figma, Miro, or other cloud-based work spaces are © {{ company }}.</p>
</aside>
{% endif %}
