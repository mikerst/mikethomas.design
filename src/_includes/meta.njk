<meta property="og:site_name" content="mikethomas.design">
<meta property="og:type" content="{% if layoutClass == "work" %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ intro or site.description }}">
<meta property="og:image" content="{{ site.rootUrl }}/_assets/img/{{ hero or 'opengraph.png' }}">
<meta property="og:url" content="{{ site.rootUrl }}{{ page.url }}">
{% if layoutClass == "work" %}<meta property="article:published_time" content="{{ page.date.toISOString() }}">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image:alt" content="{{ heroAlt if hero else '' }}">
